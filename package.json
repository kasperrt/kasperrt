{
  "name": "kasperrt.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "pnpm check:lint && pnpm check:format && pnpm check:ts",
    "check:format": "pnpm exec biome format --error-on-warnings",
    "check:lint": "pnpm exec biome lint --error-on-warnings",
    "check:ts": "astro check && tsc --noEmit",
    "postinstall": "astro sync",
    "check:watch": "tsc --noEmit --watch",
    "fix": "pnpm exec biome check --write",
    "fix:format": "pnpm exec biome format --write",
    "fix:lint": "pnpm exec biome lint --write"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@sentry/browser": "10.32.1",
    "astro": "5.16.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/vite": "4.1.18",
    "@sentry/vite-plugin": "4.6.1",
    "@types/node": "22",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "onlyBuiltDependencies": ["@sentry/cli", "esbuild"]
}
