{
  "name": "kasperrt.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "pnpm check:lint && pnpm check:format && pnpm check:ts",
    "check:format": "pnpm exec biome format --error-on-warnings",
    "check:lint": "pnpm exec biome lint --error-on-warnings",
    "check:ts": "astro check && tsc --noEmit",
    "postinstall": "astro sync",
    "check:watch": "tsc --noEmit --watch",
    "fix": "pnpm exec biome check --write",
    "fix:format": "pnpm exec biome format --write",
    "fix:lint": "pnpm exec biome lint --write"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "svelte": "5.56.4",
    "three": "0.185.1",
    "wiretyped": "0.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.1",
    "@types/three": "0.185.0",
    "astro": "7.0.7",
    "js-yaml": "4.2.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "peerDependencies": {
    "terser": "5.46.2"
  }
}
