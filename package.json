{
  "name": "kasperrt.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && node scripts/compress.mjs && pnpm check:size",
    "dev": "astro dev",
    "preview": "node scripts/preview.mjs",
    "check:size": "node scripts/check-size.mjs",
    "sync": "astro sync",
    "check": "pnpm check:lint && pnpm check:format && pnpm check:ts",
    "check:format": "pnpm exec biome format --error-on-warnings",
    "check:lint": "pnpm exec biome lint --error-on-warnings",
    "check:ts": "astro check && tsc --noEmit",
    "postinstall": "astro sync",
    "check:watch": "tsc --noEmit --watch",
    "fix": "pnpm exec biome check --write",
    "fix:format": "pnpm exec biome format --write",
    "fix:lint": "pnpm exec biome lint --write"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "pdfkit": "0.20.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/fontkit": "2.0.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.1",
    "@types/pdfkit": "0.17.6",
    "astro": "7.2.8",
    "js-yaml": "4.3.2",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "peerDependencies": {
    "terser": "5.46.2"
  }
}
