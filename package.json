{
  "name": "kasperrt.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "pnpm check:lint && pnpm check:format && pnpm check:ts",
    "check:format": "pnpm exec biome format --error-on-warnings",
    "check:lint": "pnpm exec biome lint --error-on-warnings",
    "check:ts": "astro check && tsc --noEmit",
    "postinstall": "astro sync",
    "check:watch": "tsc --noEmit --watch",
    "fix": "pnpm exec biome check --write",
    "fix:format": "pnpm exec biome format --write",
    "fix:lint": "pnpm exec biome lint --write"
  },
  "dependencies": {
    "@astrojs/svelte": "8.1.0",
    "svelte": "5.55.5",
    "three": "0.184.0",
    "wiretyped": "0.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "25.6.0",
    "@types/three": "0.184.0",
    "astro": "6.2.1",
    "front-matter": "4.0.2",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "7.3.2"
  },
  "peerDependencies": {
    "terser": "5.46.2"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
