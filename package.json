{
  "name": "kasperrt.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "pnpm check:lint && pnpm check:format && pnpm check:ts",
    "check:format": "pnpm exec biome format --error-on-warnings",
    "check:lint": "pnpm exec biome lint --error-on-warnings",
    "check:ts": "astro check && tsc --noEmit",
    "postinstall": "astro sync",
    "check:watch": "tsc --noEmit --watch",
    "fix": "pnpm exec biome check --write",
    "fix:format": "pnpm exec biome format --write",
    "fix:lint": "pnpm exec biome lint --write"
  },
  "dependencies": {
    "@astrojs/svelte": "7.2.4",
    "svelte": "5.46.1",
    "wiretyped": "0.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.0",
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22",
    "astro": "5.16.6",
    "front-matter": "4.0.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "terser": "5.44.1"
  },
  "onlyBuiltDependencies": ["esbuild"]
}
