---
import "../styles/app.css";
import { getCollection } from "astro:content";
import AppWindow from "~/components/apps/AppWindow.astro";
import { windowApps } from "~/data/window-apps";
import Desktop from "~/components/Desktop.astro";
import desktopBootstrap from "~/utils/desktop/bootstrap.js";
import { safeWrap } from "~/utils/wrap";
import { backgroundStorageKey } from "~/utils/desktop/background";
import { getInitialWindow } from "~/utils/desktop/routes";
import { optionalIsoDate, siteUrl, structuredDataList } from "~/utils/page-meta";

interface Props {
  title: string;
  description: string;
  robots: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageHeight?: number;
  ogImageWidth?: number;
  ogType?: "article" | "profile" | "website";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  backgroundImage: boolean;
  menu: boolean;
  twitterHandle: string;
  author?: string;
  ogUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title,
  description,
  robots,
  ogImage = "/og/desktop/home.png",
  ogImageAlt = `${title} social preview`,
  ogImageHeight = 630,
  ogImageWidth = 1200,
  ogType = "website",
  publishedTime,
  modifiedTime,
  twitterHandle,
  author = "Kasper Rynning-Tønnesen",
  ogUrl: ogUrlProp,
  structuredData,
  twitterCard: twitterCardProp,
}: Props = Astro.props;
const initialWindow = getInitialWindow(Astro.url.pathname);
const posts = await getCollection("blog");
const windowIds = [...windowApps, ...posts.map((post) => `article-${post.id}`)].join(" ");
const canonicalUrl = siteUrl(Astro.url.pathname, Astro.site, "");
const rssUrl = siteUrl("/rss.xml", Astro.site);
const authorUrl = siteUrl("/", Astro.site);
const ogUrl = ogUrlProp ?? canonicalUrl;
const image = siteUrl(ogImage, Astro.site);
const structuredDataItems = structuredDataList(structuredData);
const twitterCard = twitterCardProp ?? "summary_large_image";
const publishedTimeIso = optionalIsoDate(publishedTime);
const modifiedTimeIso = optionalIsoDate(modifiedTime);
const desktopBootstrapScript = `(${desktopBootstrap.toString()})(${safeWrap.toString()}, ${JSON.stringify(backgroundStorageKey)});`;
---

<!doctype html>
<html
  class="min-w-80 overflow-hidden overscroll-none bg-[var(--desktop,#bba8de)] [transition:var(--desktop-transition,none)] scheme-light print:m-0 print:h-auto print:min-h-0 print:overflow-visible print:bg-white print:p-0 print:transition-none motion-reduce:transition-none"
  lang="en"
  prefix="og: https://ogp.me/ns# profile: https://ogp.me/ns/profile# article: https://ogp.me/ns/article#"
>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={desktopBootstrapScript} />
    <link rel="preload" href="/fonts/ChicagoFLF-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script
      defer
      is:inline
      data-domain="kasperrt.me"
      src="https://analytics.kasperrt.me/js/script.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    <link rel="author" href={authorUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kasper Rynning-Tønnesen | Blog"
      href={rssUrl}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:site_name" content="kasperrt.me" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    {ogType === "profile" && <meta property="profile:first_name" content="Kasper" />}
    {ogType === "profile" && <meta property="profile:last_name" content="Rynning-Tønnesen" />}
    {ogType === "profile" && <meta property="profile:username" content="kasperrt" />}
    {ogType === "article" && publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
    {ogType === "article" && modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
    {ogType === "article" && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      structuredDataItems.map((item) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(item)}
        />
      ))
    }
    <meta
      name="theme-color"
      content="#b09acb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#b09acb"
      media="(prefers-color-scheme: dark)"
    />
  </head>

  <body
    class="m-0 h-svh min-h-svh overflow-hidden overscroll-none bg-[var(--desktop,#bba8de)] bg-[repeating-linear-gradient(0deg,#ffffff04_0_1px,transparent_1px_2px)] p-0 font-desktop text-xs/normal text-neutral-900 [transition:var(--desktop-transition,none)] [:where(&)_a]:text-link [:where(&)_a]:underline [:where(&)_a]:underline-offset-2 [:where(&)_a:visited]:text-purple-900 [:where(&)_a:hover]:text-blue-950 selection:bg-selection selection:text-white [:where(&)_button]:cursor-pointer [&_:where(button,a,summary,[tabindex]):focus-visible]:outline [&_:where(button,a,summary,[tabindex]):focus-visible]:outline-dotted [&_:where(button,a,summary,[tabindex]):focus-visible]:-outline-offset-2 [&_input:focus-visible]:outline [&_input:focus-visible]:outline-indigo-700 [&_input:focus-visible]:outline-offset-1 [&.dragging]:cursor-grabbing [&.dragging]:select-none [&.dragging_*]:cursor-grabbing [&.dragging_*]:select-none [&.dragging_iframe]:pointer-events-none motion-reduce:transition-none print:m-0 print:h-auto print:min-h-0 print:overflow-visible print:bg-white print:bg-none print:p-0 print:transition-none print:[&>:not(#cv-window)]:hidden"
    data-initial-window={initialWindow}
    data-window-ids={windowIds}
  >
    <a class="skip-link fixed -top-20 left-5 z-20000 bg-white p-2 focus:top-7.5" href="#main-content">Skip to content</a>
    <Desktop />
    <AppWindow id="main" initial={initialWindow === "main"} />
    {initialWindow !== "main" && <AppWindow id={initialWindow} initial />}
    <script>import "../utils/desktop";</script>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 12mm; }
</style>
