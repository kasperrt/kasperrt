---
import "../styles/app.css";
import DesktopWindow from "~/components/DesktopWindow.astro";
import Home from "~/components/apps/Home.astro";
import Projects from "~/components/apps/Projects.astro";
import Writing from "~/components/apps/Writing.astro";
import CV from "~/components/apps/CV.astro";
import PrintCV from "~/components/apps/PrintCV.astro";
import { ClientRouter } from "astro:transitions";
import Desktop from "~/components/Desktop.astro";
import Terminal from "~/components/Terminal.astro";
import desktopBootstrap from "~/utils/desktop/bootstrap.js?raw";
import BlogWindows from "~/components/apps/BlogWindows.astro";
import { getInitialWindow } from "~/utils/desktop/routes";
import { optionalIsoDate, siteUrl, structuredDataList } from "~/utils/page-meta";

interface Props {
  title: string;
  description: string;
  robots: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageHeight?: number;
  ogImageWidth?: number;
  ogType?: "article" | "profile" | "website";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  backgroundImage: boolean;
  menu: boolean;
  twitterHandle: string;
  author?: string;
  ogUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  twitterCard?: "summary" | "summary_large_image";
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  robots,
  ogImage = "/og/desktop/home.png",
  ogImageAlt = `${title} social preview`,
  ogImageHeight = 630,
  ogImageWidth = 1200,
  ogType = "website",
  publishedTime,
  modifiedTime,
  twitterHandle,
  author = "Kasper Rynning-Tønnesen",
  ogUrl: ogUrlProp,
  structuredData,
  twitterCard: twitterCardProp,
  htmlClass = "",
  bodyClass = "",
}: Props = Astro.props;
const initialWindow = getInitialWindow(Astro.url.pathname);
const canonicalUrl = siteUrl(Astro.url.pathname, Astro.site, "");
const rssUrl = siteUrl("/rss.xml", Astro.site);
const authorUrl = siteUrl("/", Astro.site);
const ogUrl = ogUrlProp ?? canonicalUrl;
const image = siteUrl(ogImage, Astro.site);
const structuredDataItems = structuredDataList(structuredData);
const twitterCard = twitterCardProp ?? "summary_large_image";
const publishedTimeIso = optionalIsoDate(publishedTime);
const modifiedTimeIso = optionalIsoDate(modifiedTime);
const isConsolePage = bodyClass === "console-page";
---

<!doctype html>
<html
  lang="en"
  class={htmlClass}
  prefix="og: https://ogp.me/ns# profile: https://ogp.me/ns/profile# article: https://ogp.me/ns/article#"
>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={desktopBootstrap} />
    <link rel="preload" href="/fonts/ChicagoFLF.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script
      defer
      is:inline
      data-domain="kasperrt.me"
      src="https://analytics.kasperrt.me/js/script.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    <link rel="author" href={authorUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kasper Rynning-Tønnesen | Blog"
      href={rssUrl}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:site_name" content="kasperrt.me" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    {ogType === "profile" && <meta property="profile:first_name" content="Kasper" />}
    {ogType === "profile" && <meta property="profile:last_name" content="Rynning-Tønnesen" />}
    {ogType === "profile" && <meta property="profile:username" content="kasperrt" />}
    {ogType === "article" && publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
    {ogType === "article" && modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
    {ogType === "article" && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      structuredDataItems.map((item) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(item)}
        />
      ))
    }
    <meta
      name="theme-color"
      content="#b09acb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#b09acb"
      media="(prefers-color-scheme: dark)"
    />
    <ClientRouter />
  </head>

  <body class={bodyClass} data-initial-window={initialWindow}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isConsolePage && <main id="main-content"><slot /></main>}
    {!isConsolePage && (
      <>
        <Desktop />
        <DesktopWindow id="main" title="kasperrt.me" initial={initialWindow === "main"}><Home /></DesktopWindow>
        <DesktopWindow id="projects" title="Projects" initial={initialWindow === "projects"}><Projects /></DesktopWindow>
        <DesktopWindow id="writing" title="Writing" initial={initialWindow === "writing"}><Writing /></DesktopWindow>
        <DesktopWindow id="cv" title="Curriculum Vitae" initial={initialWindow === "cv"}><CV /></DesktopWindow>
        <BlogWindows initialWindow={initialWindow} />
        <Terminal />
        <PrintCV />
      </>
    )}
    <script>import "../utils/desktop";</script>
  </body>
</html>
