---
import "../styles/app.css";
import Header from "~/components/Header.astro";
import { ClientRouter } from "astro:transitions";
import Image from "~/components/Image.astro";

interface Props {
  title: string;
  description: string;
  robots: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageHeight?: number;
  ogImageWidth?: number;
  ogType?: "article" | "profile" | "website";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  backgroundImage: boolean;
  menu: boolean;
  twitterHandle: string;
  author?: string;
  ogUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  twitterCard?: "summary" | "summary_large_image";
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  robots,
  ogImage = "/me-small.png",
  ogImageAlt = `${title} social preview`,
  ogImageHeight,
  ogImageWidth,
  ogType = "website",
  publishedTime,
  modifiedTime,
  backgroundImage,
  menu,
  twitterHandle,
  author = "Kasper Rynning-Tønnesen",
  ogUrl: ogUrlProp,
  structuredData,
  twitterCard: twitterCardProp,
  htmlClass = "",
  bodyClass = "",
}: Props = Astro.props;
const activePath = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : "";
const rssUrl = Astro.site ? new URL("/rss.xml", Astro.site).toString() : "/rss.xml";
const authorUrl = Astro.site ? new URL("/", Astro.site).toString() : "/";
const ogUrl = ogUrlProp ?? canonicalUrl;
const image = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
const structuredDataItems = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
const twitterCard = twitterCardProp ?? (ogImage === "/me-small.png" ? "summary" : "summary_large_image");
const toIsoString = (value?: Date | string) => (value ? new Date(value).toISOString() : undefined);
const publishedTimeIso = toIsoString(publishedTime);
const modifiedTimeIso = toIsoString(modifiedTime);
---

<!doctype html>
<html
  lang="en"
  class={htmlClass}
  prefix="og: https://ogp.me/ns# profile: https://ogp.me/ns/profile# article: https://ogp.me/ns/article#"
>
  <head>
    <meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script
      defer
      is:inline
      data-domain="kasperrt.me"
      src="https://analytics.kasperrt.me/js/script.js"></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    <link rel="author" href={authorUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kasper Rynning-Tønnesen | Blog"
      href={rssUrl}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:site_name" content="kasperrt.me" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    {ogType === "profile" && <meta property="profile:first_name" content="Kasper" />}
    {ogType === "profile" && <meta property="profile:last_name" content="Rynning-Tønnesen" />}
    {ogType === "profile" && <meta property="profile:username" content="kasperrt" />}
    {ogType === "article" && publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
    {ogType === "article" && modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
    {ogType === "article" && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      structuredDataItems.map((item) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(item)}
        />
      ))
    }
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f0f0f"
      media="(prefers-color-scheme: dark)"
    />
    <ClientRouter />
  </head>

  <body class={bodyClass}>
    {
      backgroundImage && (
        <Image
          data-rotate="4"
          data-shadow-multiplier="-7.5"
          data-tilt-multiplier="1"
          sources={[
            { srcSet: "/me.webp", type: "image/webp" },
            { srcSet: "/me.png", type: "image/png" },
          ]}
          style="box-shadow: 9.91031px 9.61118px var(--image-shadow-color)"
          transition:name="me-picture"
          imageClass="absolute -top-2/5 bottom-0 left-1/5 m-auto h-[fit-content,min-content,auto] max-h-3/5 max-w-2/5 opacity-100 transition-[border,opacity] lg:fixed lg:top-0 lg:left-1/2 lg:max-h-4/5 lg:max-w-2/6 rounded-sm"
        />
      )
    }

    {menu && <Header activePath={activePath} />}

    <main class="relative flex flex-1 lg:min-h-svh">
      <slot />
    </main>

    <script>
      import { rotateElement, getRotateElements } from "~/utils/rotate";
      import { hasTouchSupport } from "~/utils/touch";

      let elements = getRotateElements();
      function onMouseMove(event: MouseEvent) {
        if (!document || elements.length === 0) {
          return;
        }

        const { clientWidth, clientHeight } = document.documentElement;

        for (const { multiplier, ...element } of elements) {
          const left = (event.clientX / clientWidth - 0.5) * multiplier;
          const top = (event.clientY / clientHeight - 0.5) * multiplier;
          rotateElement(element, left, top);
        }
      }

      function onDeviceOrientation(event: DeviceOrientationEvent) {
        if (!event || !event.beta || !event.gamma || elements.length === 0) {
          return;
        }

        const x = Math.round(event.gamma * 10) / 10;
        const y = Math.round(event.beta * 10) / 10;
        const movement = 0.5;

        for (const { multiplier, ...element } of elements) {
          const left = -(x / 10) * movement * multiplier;
          const top = (y / 10) * movement * multiplier;
          rotateElement(element, -(left - 0.5), -(top - 0.5));
        }
      }

      let listenersBound = false;
      function bindListeners() {
        if (listenersBound || hasTouchSupport()) {
          return;
        }

        listenersBound = true;
        window.addEventListener("deviceorientation", onDeviceOrientation, {
          passive: true,
        });

        window.addEventListener("mousemove", onMouseMove, { passive: true });
      }

      function initMotion() {
        elements = getRotateElements();
        bindListeners();
      }

      initMotion();

      document.addEventListener("astro:page-load", initMotion);
      document.addEventListener("astro:after-swap", initMotion);
    </script>

    <script>
      /**
       * iOS astro view-transitions breaks back-forward-navigation
       * https://github.com/withastro/astro/issues/11919#issuecomment-2428186492
       */
      document.addEventListener("click", (e) => {
        if (!/iPad|iPhone|iPod/.test(navigator.userAgent)) {
          return false;
        }
        const target = e.target as Element;
        if (!target) {
          return;
        }

        const link = target.closest("a");
        const shouldPushState =
          link &&
          link.href &&
          link.href.startsWith(window.location.origin) &&
          !link.href.includes("#");
        if (!shouldPushState) {
          return;
        }

        history.pushState(null, "", link.href);
        window.dispatchEvent(new PopStateEvent("popstate"));
      });

      function setBottomOverlay() {
        const vv = window.visualViewport;
        if (!vv) {
          return;
        }

        const overlap = Math.max(
          0,
          window.innerHeight - vv.height - vv.offsetTop
        );
        document.documentElement.style.setProperty(
          "--bottom-overlay",
          overlap + "px"
        );
      }

      setBottomOverlay();
      window.addEventListener("resize", setBottomOverlay);
      window.visualViewport?.addEventListener("resize", setBottomOverlay);
    </script>
  </body>
</html>
