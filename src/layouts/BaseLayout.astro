---
import "../styles/app.css";
import Header from "~/components/Header.astro";
import { ClientRouter } from "astro:transitions";
import Image from "~/components/Image.astro";

interface Props {
  title: string;
  description: string;
  keywords: string;
  robots: string;
  ogTitle: string;
  ogDescription: string;
  ogImage: string;
  backgroundImage: boolean;
  menu: boolean;
  twitterHandle: string;
  author?: string;
  ogUrl?: string;
}

const {
  title,
  description,
  keywords,
  robots,
  ogTitle,
  ogDescription,
  ogImage,
  backgroundImage,
  menu,
  twitterHandle,
  author = "Kasper Rynning-Tønnesen",
  ogUrl: ogUrlProp,
}: Props = Astro.props;
const activePath = Astro.url.pathname;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "";
const ogUrl = ogUrlProp ?? canonicalUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      defer
      is:inline
      data-domain="kasperrt.me"
      src="https://analytics.kasperrt.me/js/script.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:site_name" content={author} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f0f0f"
      media="(prefers-color-scheme: dark)"
    />
  </head>

  <body>
    {
      backgroundImage && (
        <Image
          data-rotate="4"
          data-shadow-multiplier="5"
          sources={[
            { srcSet: "/me.webp", type: "image/webp" },
            { srcSet: "/me.png", type: "image/png" },
          ]}
          style="box-shadow: 9.91031px 9.61118px var(--image-shadow-color)"
          imageClass="view-transition-picture absolute -top-2/5 bottom-0 left-1/5 m-auto h-[fit-content,min-content,auto] max-h-3/5 max-w-2/5 opacity-100 transition-[border,opacity] md:fixed md:top-0 md:left-1/2 md:max-h-4/5 md:max-w-2/6"
        />
      )
    }

    {menu && <Header activePath={activePath} />}

    <main class="relative flex flex-1 md:min-h-svh">
      <slot />
    </main>

    <script>
      import { rotateElement, getRotateElements } from "~/utils/rotate";
      import { hasTouchSupport } from "~/utils/touch";

      let elements = getRotateElements();
      function onMouseMove(event: MouseEvent) {
        if (!document || elements.length === 0) {
          return;
        }

        const { clientWidth, clientHeight } = document.documentElement;

        for (const { element, multiplier, shadowMultiplier } of elements) {
          const left = (event.clientX / clientWidth - 0.5) * multiplier;
          const top = (event.clientY / clientHeight - 0.5) * multiplier;
          rotateElement(element, left, top, shadowMultiplier);
        }
      }

      function onDeviceOrientation(event: DeviceOrientationEvent) {
        if (!event || !event.beta || !event.gamma || elements.length === 0) {
          return;
        }

        const x = Math.round(event.gamma * 10) / 10;
        const y = Math.round(event.beta * 10) / 10;
        const movement = 0.5;

        for (const { element, multiplier, shadowMultiplier } of elements) {
          const left = -(x / 10) * movement * multiplier;
          const top = (y / 10) * movement * multiplier;
          rotateElement(element, -(left - 0.5), -(top - 0.5), shadowMultiplier);
        }
      }

      let listenersBound = false;
      function bindListeners() {
        if (listenersBound || hasTouchSupport()) {
          return;
        }

        listenersBound = true;
        window.addEventListener("deviceorientation", onDeviceOrientation, {
          passive: true,
        });

        window.addEventListener("mousemove", onMouseMove, { passive: true });
      }

      function initMotion() {
        elements = getRotateElements();
        bindListeners();
      }

      initMotion();

      document.addEventListener("astro:page-load", initMotion);
      document.addEventListener("astro:after-swap", initMotion);
    </script>
  </body>
</html>

<ClientRouter />
