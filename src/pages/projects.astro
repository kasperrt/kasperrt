---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { projectsMeta } from "~/data/meta";
import { getPageProjects } from "~/data/projects";
import { absoluteUrl, createPersonJsonLd, createWebsiteJsonLd } from "~/utils/seo";
const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    url: absoluteUrl("/projects/"),
    name: projectsMeta.title,
    description: projectsMeta.description,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: getPageProjects().map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "WebSite",
          name: project.name,
          url: project.url,
          description: project.blurb ?? project.tagline,
        },
      })),
    },
  },
];
---
<BaseLayout {...projectsMeta} backgroundImage={false} menu structuredData={structuredData} />
