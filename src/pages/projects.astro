---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Image from "~/components/Image.astro";
import Underline from "~/components/Underline.astro";
import { classNames } from "~/utils/classNames";
import { getPageProjects } from "~/data/projects";
import { projectsMeta } from "~/data/meta";
import { absoluteUrl, createPersonJsonLd, createWebsiteJsonLd } from "~/utils/seo";

const pageProjects = getPageProjects();

const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${absoluteUrl("/projects/")}#collection`,
    url: absoluteUrl("/projects/"),
    name: projectsMeta.title,
    description: projectsMeta.description,
    inLanguage: "en",
    isPartOf: {
      "@id": `${absoluteUrl("/")}#website`,
    },
    about: {
      "@id": `${absoluteUrl("/")}#person`,
    },
    mainEntity: {
      "@type": "ItemList",
      itemListOrder: "https://schema.org/ItemListUnordered",
      numberOfItems: pageProjects.length,
      itemListElement: pageProjects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "WebSite",
          name: project.name,
          url: project.url,
          description: project.blurb ?? project.tagline,
          image: project.image ? absoluteUrl(`/projects/${project.image}.jpg`) : undefined,
          author: {
            "@id": `${absoluteUrl("/")}#person`,
          },
        },
      })),
    },
  },
];
---

<BaseLayout
  {...projectsMeta}
  backgroundImage={false}
  menu
  structuredData={structuredData}
>
  <section
    class="markdown flex w-full max-w-248 flex-col gap-16 px-6 py-10 lg:w-3/5 lg:gap-24"
  >
    <header class="flex flex-col gap-2">
      <h1 class="text-3xl text-red-600 dark:text-red-400">Tinkering</h1>
      <p class="font-light text-neutral-700 dark:text-neutral-200">
        A bunch of side projects, tools and experiments.
        <br />I enjoy fucking around to find out, and these are the ones worth
        having public.
      </p>
    </header>

    <ul class="flex flex-col gap-16 lg:gap-24">
      {
        pageProjects.map((project, index) => {
          const flipped = index % 2 === 1;

          return (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class={classNames(
                  "slug-link group flex flex-col gap-6 sm:items-center sm:gap-10",
                  flipped ? "sm:flex-row-reverse" : "sm:flex-row"
                )}
              >
                {project.image && (
                  <Image
                    alt={project.alt ?? `${project.name} screenshot`}
                    loading="lazy"
                    decoding="async"
                    width="1024"
                    height="640"
                    pictureClass="block w-full shrink-0 rounded-sm transition-all duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-[8px_8px_0_0_var(--project-shadow-color)] motion-reduce:transition-none sm:w-5/12"
                    imageClass="aspect-[16/10] w-full rounded-sm object-cover object-top"
                    sources={[
                      { srcSet: `/projects/${project.image}.webp`, type: "image/webp" },
                      { srcSet: `/projects/${project.image}.jpg`, type: "image/jpeg" },
                    ]}
                  />
                )}
                <div
                  class={classNames(
                    "flex flex-col gap-3 sm:w-7/12",
                    flipped && "sm:items-end sm:text-right"
                  )}
                >
                  <h2 class="block font-bold text-2xl">
                    <Underline direction={flipped ? "left" : "right"}>
                      {project.name}
                    </Underline>
                  </h2>
                  <p class="font-light text-neutral-700 dark:text-neutral-200">
                    {project.blurb ?? project.tagline}
                  </p>
                  <span class="font-mono text-neutral-500 text-sm transition-colors duration-300 group-hover:text-red-600 dark:text-neutral-400 dark:group-hover:text-red-400">
                    {project.host}{" "}
                    <span class="inline-block transition-transform duration-300 ease-out group-hover:rotate-45 motion-reduce:transition-none">
                      &nearr;
                    </span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
