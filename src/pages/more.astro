---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { resumeMeta } from "~/data/meta";
import { absoluteUrl, createPersonJsonLd, createProfilePageJsonLd, createWebsiteJsonLd } from "~/utils/seo";
const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  createProfilePageJsonLd(absoluteUrl("/more/"), resumeMeta.description),
];
---
<BaseLayout {...resumeMeta} backgroundImage={false} menu ogType="profile" structuredData={structuredData} />
