---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { rootMeta } from "~/data/meta";
import { absoluteUrl, createPersonJsonLd, createProfilePageJsonLd, createWebsiteJsonLd } from "~/utils/seo";
const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  createProfilePageJsonLd(absoluteUrl("/"), rootMeta.description),
];
---
<BaseLayout {...rootMeta} backgroundImage={false} menu ogType="profile" structuredData={structuredData} />
