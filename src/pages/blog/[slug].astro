---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { absoluteUrl, createBlogPostingJsonLd, createPersonJsonLd, createWebsiteJsonLd } from "~/utils/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const pageTitle = `${post.data.title} | kasper rynning-tønnesen`;
const pageDescription = post.data.description;
let robots = "index, follow";
if (post.data.draft) {
  robots = "noindex, nofollow";
}
const canonicalUrl = absoluteUrl(`/blog/${post.id}/`);
const imageUrl = absoluteUrl(post.data.hero);
const dateModified = post.data.updatedDate ?? post.data.pubDate;
const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  createBlogPostingJsonLd({
    canonicalUrl,
    dateModified,
    datePublished: post.data.pubDate,
    description: pageDescription,
    headline: post.data.title,
    image: imageUrl,
  }),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  robots={robots}
  ogImage={post.data.hero}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={dateModified}
  structuredData={structuredData}
  twitterHandle="kasper_rt"
  backgroundImage={false}
  menu
>
</BaseLayout>
