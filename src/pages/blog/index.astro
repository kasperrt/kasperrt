---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { blogIndexMeta } from "~/data/meta";
import { createPersonJsonLd, createWebsiteJsonLd } from "~/utils/seo";
const structuredData = [
  createPersonJsonLd(),
  createWebsiteJsonLd(),
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://kasperrt.me/blog/#blog",
    name: blogIndexMeta.title,
    description: blogIndexMeta.description,
    url: "https://kasperrt.me/blog/",
    author: { "@id": "https://kasperrt.me/#person" },
    inLanguage: "en",
  },
];
---
<BaseLayout {...blogIndexMeta} backgroundImage={false} menu structuredData={structuredData} />
