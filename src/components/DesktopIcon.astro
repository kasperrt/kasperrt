---
interface Props {
  kind?: "computer" | "folder" | "text" | "terminal" | "mail";
  size?: number;
}
const { kind = "folder", size = 32 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" shape-rendering="crispEdges" aria-hidden="true" class="desktop-icon-image">
  {kind === "computer" && <><path fill="#000" d="M3 2h25v21H18v3h11v5H2v-5h11v-3H3z"/><path fill="#fff" d="M4 3h23v19H4z"/><path fill="#c0c0c0" d="M5 4h21v17H5zM14 22h3v5h10v2H4v-2h10z"/><path fill="#808080" d="M6 5h19v14H6zM4 29h24v1H4z"/><path fill="#596c8d" d="M7 6h17v12H7z"/><path fill="#c0c8e1" d="M8 7h15v10H8z"/><path fill="#fff" d="M8 7h4v8H8z"/><path fill="#fff" d="M5 27h7v1H5z"/></>}
  {kind === "folder" && <><path fill="#000" d="M1 7h12l3 3h14v18H1z"/><path fill="#bdcde7" d="M2 8h10l3 3h14v15H2z"/><path fill="#7588a7" d="M2 12h27v2H5v12H2z"/><path fill="#000" d="M6 13h26l-5 15H1z"/><path fill="#bdcde7" d="M7 14h24l-5 13H3z"/><path fill="#a9bbd9" d="M8 15h22l-4 11H4z"/><path fill="#fff" d="M8 14h22v1H8zM2 8h10v1H2z"/></>}
  {kind === "text" && <><path fill="#000" d="M5 1h16l7 7v23H5z"/><path fill="#fff" d="M6 2h14v7h7v21H6z"/><path fill="#c0c0c0" d="M21 3v5h5zM25 10h2v19H7v-1h18z"/><path fill="#596c8d" d="M9 6h8v1H9zM9 11h13v1H9zM9 14h14v1H9zM9 17h12v1H9zM9 20h14v1H9zM9 23h9v1H9z"/></>}
  {kind === "terminal" && <><path fill="#000" d="M1 4h30v25H1z"/><path fill="#fff" d="M2 5h28v23H2z"/><path fill="#596c8d" d="M3 6h26v5H3z"/><path fill="#c0c0c0" d="M24 7h4v3h-4z"/><path fill="#000" d="M3 12h26v15H3z"/><path fill="#c0c0c0" d="M5 15h2v1H5zM7 16h2v1H7zM5 17h2v1H5zM10 19h5v1h-5z"/></>}
  {kind === "mail" && <><path fill="#000" d="M1 8h30v19H1z"/><path fill="#fff" d="M2 9h28v17H2z"/><path fill="#c0c0c0" d="M3 10h26v15H3z"/><path stroke="#808080" d="m2 9 14 11L30 9M2 26l10-10m8 0 10 10"/><path stroke="#fff" d="m3 9 13 10L29 9"/></>}
</svg>
