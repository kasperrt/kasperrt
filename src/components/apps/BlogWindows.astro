---
import { getCollection } from "astro:content";
import DesktopWindow from "../DesktopWindow.astro";
import BlogPost from "./BlogPost.astro";
interface Props {
  initialWindow: string;
}
const { initialWindow } = Astro.props;
const posts = await getCollection("blog", ({ id, data }) => !data.draft || initialWindow === `article-${id}`);
---
{posts.map((post) => {
  const id = `article-${post.id}`;
  const initial = id === initialWindow;
  return <DesktopWindow id={id} title={`${post.data.title}.txt`} initial={initial} source={`/blog/${post.id}`}>
    {initial ? <BlogPost post={post} /> : <p class="article-loading" role="status">Opening post…</p>}
  </DesktopWindow>;
})}
