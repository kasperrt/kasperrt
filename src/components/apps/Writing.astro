---
import { getCollection } from "astro:content";
import { formatReadingTime } from "~/utils/readingTime";

const sortedPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<section class="archive-page px-7.5 pt-6 pb-9 max-md:p-5.5 max-sm:px-4 max-sm:py-4.5 @max-lg:p-5">
  <header class="page-heading mb-6 border-b border-neutral-300 pb-3.75">
    <h1 class="mb-3 font-desktop text-2xl/snug">Writing</h1>
    <p class="mb-2 max-w-164 font-sans text-sm/relaxed max-sm:text-xs">I <s>sometimes</s> often go on rants and tangents. Once in a while, I put it in writing. Mostly tech, occasionally everything else.</p>
    <a class="record-link text-xs" href="/rss.xml">Subscribe via RSS ↗</a>
  </header>
  {sortedPosts.length === 0 && <p class="archive-empty py-5">No entries yet. The operator is probably debugging something.</p>}
  {sortedPosts.map((post) => (
      <a class="blog-record grid grid-cols-6 gap-3.75 border-b border-neutral-300 py-5 text-black no-underline visited:text-black hover:text-black max-sm:grid-cols-1 max-sm:gap-1 max-sm:py-4 @max-lg:grid-cols-1 @max-lg:gap-1.25" href={`/blog/${post.id}`}>
        <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs/6 text-neutral-600">{post.data.pubDate.toISOString().slice(0, 10)}</time>
        <div class="col-span-5 max-sm:col-span-1 @max-lg:col-span-1">
          <h2 class="mb-2.5 font-desktop text-base/snug text-blue-700 underline">{post.data.title}</h2>
          <p class="mb-2.25 text-xs">{post.data.description}</p>
          <span class="reading-time text-xs text-neutral-600">{formatReadingTime(post.body ?? "")}</span>
        </div>
      </a>
  ))}
</section>
