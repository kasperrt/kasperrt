---
import { getCollection } from "astro:content";
import { formatReadingTime } from "~/utils/readingTime";
const sortedPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---
<section class="archive-page">
    <header class="page-heading"><h1>Writing</h1><p>I <s>sometimes</s> often go on rants and tangents. Once in a while, I put it in writing. Mostly tech, occasionally everything else.</p><a class="record-link" href="/rss.xml">Subscribe via RSS ↗</a></header>
    {sortedPosts.length === 0 && <p class="archive-empty">No entries yet. The operator is probably debugging something.</p>}
    {sortedPosts.map((post) => <a class="blog-record" href={`/blog/${post.id}`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="reading-time">{formatReadingTime(post.body ?? '')}</span></div><span>↗</span></a>)}
  </section>
