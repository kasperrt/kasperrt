---
import WindowFrame from "../WindowFrame.astro";
import { desktopApps } from "../../data/desktop-apps";
import Header from "../Header.astro";
interface Props {
  id: string;
}
const { id } = Astro.props;
const apps = desktopApps.filter((app) => app.id === id);
---

{apps.map((app) => (
  <WindowFrame class="embedded-app-window" data-window={app.id} aria-label={app.title} hidden>
    <Header windowId={app.id} title={app.title} />
    <div class="embedded-app-bar flex items-center justify-between gap-3 border-t border-neutral-500 px-2.25 py-1.25 text-xs shadow-[inset_0_1px_#fff] [&>a]:whitespace-nowrap">
      <span>{new URL(app.url).host}</span>
      <a href={app.url} target="_blank" rel="noopener noreferrer">Open in browser ↗</a>
    </div>
    <iframe class="app-embed block min-h-0 min-w-0 w-full flex-1 touch-auto border border-neutral-500 bg-white" data-app-frame data-src={app.url} title={app.title} allow="autoplay; fullscreen; gamepad" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <span class="resize-grip pointer-events-none absolute right-px bottom-px size-3 bg-[repeating-linear-gradient(135deg,transparent_0_2px,#666_2px_3px,#eee_3px_4px)] [clip-path:polygon(100%_0,100%_100%,0_100%)]" aria-hidden="true"></span>
  </WindowFrame>
))}
