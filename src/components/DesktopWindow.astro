---
import Header from "./Header.astro";
import { classNames } from "~/utils/classNames";

interface Props {
  id: string;
  title: string;
  initial?: boolean;
  source?: string;
}

const { id, title, initial = false, source } = Astro.props;
const isMain = id === "main";
let elementId = `${id}-window`;
let status = title;
if (isMain) {
  elementId = "site-window";
  status = "kasperrt.me";
}
---

<section
  class={classNames("desktop-window document-window", isMain && "main-window")}
  id={elementId}
  data-window={id}
  data-article-src={source}
  aria-label={title}
  hidden={!initial}
>
  <Header windowId={id} title={title} />
  <div class="workspace">
    <div class="workspace-content" {...(initial && { role: "main", id: "main-content" })}>
      <slot />
    </div>
  </div>
  <footer class="window-status">
    <span>{status}</span>
    <span>Oslo, Norway</span>
  </footer>
  <span class="resize-grip" aria-hidden="true"></span>
</section>
