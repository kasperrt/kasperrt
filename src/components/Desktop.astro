---
import DesktopMenu from "./DesktopMenu.astro";
import MenuSeparator from "./MenuSeparator.astro";
import MenuItem from "./MenuItem.astro";
import WindowFrame from "./WindowFrame.astro";
import DesktopShortcut from "./DesktopShortcut.astro";
import CrashScreen from "./apps/CrashScreen.astro";
import DesktopIcon from "./DesktopIcon.astro";
import Header from "./Header.astro";
import Documents from "./apps/Documents.astro";
import { desktopGames } from "../data/desktop-apps";
---

<nav class="desktop-menubar fixed inset-x-0 top-0 z-10000 flex h-7 select-none items-stretch border-black border-b bg-neutral-200 font-desktop text-xs shadow-menubar" aria-label="Desktop menu">
  <DesktopMenu label="System menu">
    <span slot="label" class="font-system text-base/6" aria-hidden="true">👋</span>
    <MenuItem data-app-entry="main" href="/">About Kasper</MenuItem>
    <MenuItem href="mailto:kasper@rynning-toennesen.email">Send a message...</MenuItem>
    <MenuSeparator />
    <MenuItem type="button" data-desktop-exit>Exit</MenuItem>
  </DesktopMenu>
  <DesktopMenu label="File">
    <MenuItem data-app-entry="main" href="/">Open Home</MenuItem>
    <MenuItem data-app-entry="projects" href="/projects">Open Projects</MenuItem>
    <MenuItem data-app-entry="writing" href="/blog">Open Writing</MenuItem>
    <MenuItem data-app-entry="cv" href="/more">Open CV</MenuItem>
    <MenuSeparator />
    <MenuItem type="button" data-save-file disabled>Save file <span>⌘S</span></MenuItem>
    <MenuItem type="button" data-app-entry="cv" data-print-cv>Print CV...</MenuItem>
    <MenuItem type="button" data-close="active">Close Window</MenuItem>
  </DesktopMenu>
  <DesktopMenu label="View">
    <MenuItem type="button" data-zoom="active">Zoom Window</MenuItem>
    <MenuItem type="button" data-shade="active">Collapse / Expand Window</MenuItem>
    <MenuSeparator />
    <MenuItem type="button" data-desktop-reset>Clean Up Desktop</MenuItem>
  </DesktopMenu>
  <DesktopMenu label="Go">
    <MenuItem type="button" data-app-entry="terminal" data-terminal-toggle>Open Terminal <span>⌘K</span></MenuItem>
    <MenuItem type="button" data-app-entry="music" data-music-toggle>Music Player</MenuItem>
    <MenuSeparator />
      <details class="desktop-submenu group/submenu">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 whitespace-nowrap px-4 py-1 text-xs group-open/submenu:bg-selection group-open/submenu:text-white focus-visible:bg-selection focus-visible:text-white [&::-webkit-details-marker]:hidden">Games <span aria-hidden="true">▸</span></summary>
        <div class="desktop-menu-items desktop-submenu-items fixed z-1 flex min-w-44 flex-col border border-neutral-900 bg-neutral-200 py-1 shadow-menu">
    {desktopGames.map((game) => <MenuItem type="button" data-open={game.id}>{game.title}</MenuItem>)}
        </div>
      </details>
    <MenuItem type="button" data-open="runtime-lab">Runtime Lab</MenuItem>
    <MenuSeparator />
    <MenuItem type="button" data-app-entry="terminal" data-uptime-open>Uptime</MenuItem>
  </DesktopMenu>
  <DesktopMenu label="Help">
    <MenuItem type="button" data-help-toggle>Using this desktop</MenuItem>
    <MenuItem type="button" data-about-toggle>Info</MenuItem>
  </DesktopMenu>
  <div class="menubar-right ml-auto flex items-stretch gap-4 max-sm:gap-2">
    <time class="flex items-center whitespace-nowrap font-desktop text-xs/none tabular-nums" data-clock title="Oslo · Europe/Oslo">00:00</time>
    <DesktopMenu label="Desktop" alignRight>
      <Fragment slot="label"><DesktopIcon kind="computer" size={16} /><span class="max-sm:hidden">Desktop</span></Fragment>
      <MenuItem type="button" data-app-entry="main" data-open="main">kasperrt.me</MenuItem>
      <MenuItem type="button" data-app-entry="projects" data-open="projects">Projects</MenuItem>
      <MenuItem type="button" data-app-entry="writing" data-open="writing">Writing</MenuItem>
      <MenuItem type="button" data-app-entry="cv" data-open="cv">Curriculum Vitae</MenuItem>
      <MenuItem type="button" data-app-entry="terminal" data-terminal-toggle>Terminal</MenuItem>
      <MenuItem type="button" data-app-entry="music" data-music-toggle>Music Player</MenuItem>
    </DesktopMenu>
  </div>
</nav>

<nav class="desktop-shortcuts in-[.desktop-starting]:invisible" aria-label="Desktop shortcuts">
  <DesktopShortcut label="kasperrt" href="/" data-desktop-icon="home"><DesktopIcon kind="computer" /></DesktopShortcut>
  <DesktopShortcut label="Projects" href="/projects" data-desktop-icon="projects"><DesktopIcon kind="folder" /></DesktopShortcut>
  <DesktopShortcut label="Writing" href="/blog" data-desktop-icon="writing"><DesktopIcon kind="text" /></DesktopShortcut>
  <DesktopShortcut label="CV" href="/more" data-desktop-icon="cv"><DesktopIcon kind="text" /></DesktopShortcut>
  <DesktopShortcut label="Terminal" type="button" data-desktop-icon="terminal" data-terminal-toggle>
    <DesktopIcon kind="terminal" />
  </DesktopShortcut>
  <DesktopShortcut label="Music Player" type="button" data-desktop-icon="music" data-music-toggle>
    <span class="music-desktop-icon size-8 font-serif text-4xl/8 font-bold text-slate-200 [text-shadow:1px_1px_#000,-1px_-1px_#000,1px_-1px_#000,-1px_1px_#000]" aria-hidden="true">♫</span>
  </DesktopShortcut>
  <DesktopShortcut label=".git" type="button" data-desktop-icon="git" data-hidden-icon data-open="git" hidden>
    <DesktopIcon kind="folder" />
  </DesktopShortcut>
  <DesktopShortcut label=".env" type="button" data-desktop-icon="env" data-hidden-icon data-open="env" hidden>
    <DesktopIcon kind="text" />
  </DesktopShortcut>
</nav>

<DesktopShortcut label="Trash" type="button" class="right-4 bottom-6 left-auto top-auto" data-trash-can data-open="trash">
  <DesktopIcon kind="trash" />
</DesktopShortcut>

<Documents />
<CrashScreen />
<div class="desktop-selection pointer-events-none fixed z-2 border border-dashed border-purple-200 bg-purple-300/20" data-selection-box hidden aria-hidden="true"></div>
<div class="desktop-context-menu fixed z-11000 min-w-52 border border-neutral-900 bg-neutral-200 py-1 font-desktop text-xs/normal shadow-menu " data-context-menu role="menu" aria-label="Desktop actions" hidden></div>

<WindowFrame class="auxiliary-window top-32 left-50 h-84 w-104 resize-none info-window" data-window="info" aria-labelledby="info-title" hidden>
  <Header windowId="info" title="Get Info" titleId="info-title" controls={false} />
  <div class="info-content overflow-auto whitespace-pre-wrap px-5 pt-5 font-sans text-xs/relaxed" data-info-content></div>
  <div class="dialog-actions mt-auto flex justify-end px-5 pt-4 pb-5"><button type="button" class="desktop-button inline-flex min-h-6 min-w-18 cursor-pointer items-center justify-center gap-1.25 rounded-xs border border-neutral-800 bg-neutral-300 px-3 py-0.75 font-desktop text-xs text-neutral-900 no-underline shadow-button hover:bg-neutral-200 visited:text-neutral-900 active:bg-neutral-700 active:text-white active:shadow-control-pressed default-button outline-2 outline-neutral-700 outline-offset-2" data-close="info">OK</button></div>
</WindowFrame>
