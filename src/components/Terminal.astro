---
import WindowFrame from "./WindowFrame.astro";
import Header from "./Header.astro";
---
<WindowFrame class="terminal-window top-40 left-55 h-88 w-156" data-window="terminal" aria-labelledby="terminal-title" hidden>
  <Header windowId="terminal" title="Terminal" titleId="terminal-title" />
  <div class="terminal-body flex min-h-0 flex-1 flex-col border border-neutral-900 bg-zinc-900 px-2.75 py-2.25 text-zinc-200">
    <div class="terminal-output min-h-0 flex-1 overflow-auto wrap-anywhere font-mono text-xs/normal max-sm:text-xs" role="log" aria-live="polite" aria-label="Terminal output">
      <p class="mb-2 whitespace-pre-wrap">kasperrt.me</p>
      <p class="mb-2 whitespace-pre-wrap">Type help for available commands.</p>
    </div>
    <div class="gnzh-context mt-1 whitespace-nowrap font-mono text-xs/normal" aria-hidden="true"><span class="text-zinc-400">╭─</span><span class="text-green-300">guest</span><span class="text-cyan-300">@</span><span class="text-green-300">kasperrt</span> <span class="font-bold text-blue-400">~</span> <span class="text-yellow-300">‹master›</span></div>
    <form class="terminal-input-row flex min-h-7 items-center font-mono text-xs/normal max-sm:text-xs" autocomplete="off">
      <label for="shell-input" class="whitespace-nowrap">╰─➤ </label>
      <input id="shell-input" name="command" spellcheck="false" aria-label="Terminal command" class="min-w-0 flex-1 border-0 bg-transparent py-1 text-inherit outline-none focus-visible:outline-none" />
      <button type="submit" aria-label="Run command" class="border-0 bg-transparent px-1 text-base text-inherit">↵</button>
    </form>
  </div>
  <span class="resize-grip pointer-events-none absolute right-px bottom-px size-3 bg-[repeating-linear-gradient(135deg,transparent_0_2px,#666_2px_3px,#eee_3px_4px)] [clip-path:polygon(100%_0,100%_100%,0_100%)]" aria-hidden="true"></span>
</WindowFrame>
