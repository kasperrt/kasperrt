<section class="desktop-window terminal-window" data-window="terminal" aria-labelledby="terminal-title" hidden>
  <header class="window-titlebar" data-window-drag tabindex="0" aria-label="Move Terminal window with arrow keys">
    <button type="button" class="desktop-close" data-close="terminal" aria-label="Close terminal"></button>
    <span class="titlebar-stripes" aria-hidden="true"></span>
    <span class="window-title" id="terminal-title">Terminal</span>
    <span class="titlebar-stripes" aria-hidden="true"></span>
    <button type="button" class="desktop-shade" data-shade="terminal" aria-label="Collapse terminal"></button>
  </header>
  <div class="terminal-body">
    <div class="terminal-output" role="log" aria-live="polite" aria-label="Terminal output">
      <p>kasperrt.me</p>
      <p>Type help for available commands.</p>
    </div>
    <div class="gnzh-context" aria-hidden="true">
      <span class="prompt-edge">╭─</span><span class="prompt-user">guest</span><span class="prompt-at">@</span><span class="prompt-host">kasperrt</span> <span class="prompt-directory">~</span>
    </div>
    <form class="terminal-input-row" autocomplete="off">
      <label for="shell-input">╰─➤ </label>
      <input id="shell-input" name="command" spellcheck="false" aria-label="Terminal command" />
      <button type="submit" aria-label="Run command">↵</button>
    </form>
  </div>
  <span class="resize-grip" aria-hidden="true"></span>
</section>
