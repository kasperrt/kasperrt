{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": ["**", "!!build", "!!.pnpm-store", "!!.astro", "!!.svelte", "!!src/env.d.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "fix": "safe"
        },
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        }
      },
      "nursery": {
        "useSortedClasses": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/utils/desktop.ts",
        "src/utils/desktop/**",
        "src/utils/desktop-og.ts",
        "src/utils/cv*.ts",
        "src/utils/uptime.ts",
        "src/utils/page-meta.ts",
        "src/utils/build-error.ts",
        "src/pages/og/desktop/**",
        "src/pages/kasper-rynning-tonnesen-cv.pdf.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "error",
            "noNestedTernary": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte", "**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
